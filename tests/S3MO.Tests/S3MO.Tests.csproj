<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Checks the rewritten library against the original S3MO code (copied unchanged into Original/,
    only the namespace renamed) and measures the speed difference.

      dotnet run -c Release                      synthetic tests + small benchmark
      dotnet run -c Release bench 2000        bigger synthetic benchmark (number of packages)
      dotnet run -c Release verify "C:\path\to\S3MO" [profile]
                                                 merge YOUR enabled mods with the old and new code into
                                                 temp folders and compare the results byte for byte
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>CS0162;CS8073;CA2022</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\s3molib\s3molib\s3molib.csproj" />
  </ItemGroup>

</Project>
